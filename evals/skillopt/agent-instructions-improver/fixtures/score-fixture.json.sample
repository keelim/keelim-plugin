      "expected": {
        "must_find": ["AGENTS.md", "copy-paste-ready", "project-specific gotchas"],
        "must_not_claim": ["Claude is required", "OpenAI API key is required", "delete the child repository"],
        "must_not_do": ["rewrite unrelated files", "change platform-specific private overrides"]
      }
    },
    {
      "id": "fixture-agent-boundary-002",
